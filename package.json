  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "astryx": "astryx",
    "hooks:install": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "dev:preview": "vite --mode mock-preview --host 127.0.0.1 --port 5175 --strictPort",
    "dev:mail": "node scripts/local-mail.mjs"
  },
